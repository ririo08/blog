[{"data":1,"prerenderedAt":258},["ShallowReactive",2],{"navigation_docs":3,"article-tag-navigation":26,"-2022-12-03-lookback-2022":69,"-2022-12-03-lookback-2022-surround":253},[4],{"title":5,"path":6,"stem":5,"children":7,"page":25},"2022","\u002F2022",[8],{"title":9,"path":10,"stem":11,"children":12,"page":25},"12","\u002F2022\u002F12","2022\u002F12",[13,17,21],{"title":14,"path":15,"stem":16},"Discordの疑似Vtuberキットが壊れたので修正した","\u002F2022\u002F12\u002F02_discord_overlay","2022\u002F12\u002F02_discord_overlay",{"title":18,"path":19,"stem":20},"2022年の活動を振り返る","\u002F2022\u002F12\u002F03_lookback_2022","2022\u002F12\u002F03_lookback_2022",{"title":22,"path":23,"stem":24},"テスト投稿 どうもリリオです","\u002F2022\u002F12\u002Finit_post","2022\u002F12\u002F1.init_post",false,[27,46,64],{"title":14,"path":15,"meta":28},{"date":29,"tags":30,"excerpt":33},"2022-12-21 23:42:00",[31,32],"Discord","CSS",{"type":34,"value":35},"minimark",[36,40,43],[37,38,39],"p",{},"どうも、リリオです。",[37,41,42],{},"今まで使っていた Discord の Overlay を使用した OBS の Vtuber キットが HTML の仕様変更により使えなくなってしまいました。",[37,44,45],{},"今回はこちらの修正をしたのでコードを置いておこうと思います。",{"title":18,"path":19,"meta":47},{"date":48,"tags":49,"excerpt":52},"2022-12-29 18:25:30",[50,51],"振り返り","YouTube",{"type":34,"value":53},[54,61],[37,55,56],{},[57,58],"img",{"alt":59,"src":60},"","https:\u002F\u002Fuser-images.githubusercontent.com\u002F7778943\u002F209963456-0501e8eb-9d71-4aa9-bee9-6f5c30f0eeb3.jpg",[37,62,63],{},"どうも、リリオです。まだ Hexo の使い方に慣れていないので上手い書き方ができてないんですが、今年の活動をざっと振り返りたいと思います。",{"title":22,"path":23,"meta":65},{"date":66,"tags":67},"2022-12-21 01:29:00",[68],"雑記",{"id":70,"title":18,"body":71,"description":237,"extension":238,"links":239,"meta":240,"navigation":250,"path":19,"seo":251,"stem":20,"__hash__":252},"docs\u002F2022\u002F12\u002F03_lookback_2022.md",{"type":34,"value":72,"toc":230},[73,77,79,87,93,96,99,103,106,150,153,156,159,162,165,168,171,178,181,184,187,190,209,212,215,218,224],[37,74,75],{},[57,76],{"alt":59,"src":60},[37,78,63],{},[37,80,81,82,86],{},"まず、今年の動画投稿についてですが、全体では",[83,84,85],"strong",{},"160","本となりました。",[37,88,89],{},[57,90],{"alt":91,"src":92},"2022年のYouTube","https:\u002F\u002Fuser-images.githubusercontent.com\u002F7778943\u002F209963607-fff786a2-1fd7-4edf-883a-8c0dc4926097.jpg",[37,94,95],{},"かなり動画を上げましたね。",[37,97,98],{},"かなり LONG な画像になってしまいましたね。",[100,101,102],"h2",{"id":102},"再生回数等の振り返り",[37,104,105],{},"今年はショート最盛期始めもあり、再生回数自体はかなり多い感じになったと思います。",[107,108,109,122],"table",{},[110,111,112],"thead",{},[113,114,115,119],"tr",{},[116,117,118],"th",{},"項目",[116,120,121],{},"数値",[123,124,125,134,142],"tbody",{},[113,126,127,131],{},[128,129,130],"td",{},"再生回数",[128,132,133],{},"78,000 回",[113,135,136,139],{},[128,137,138],{},"再生時間",[128,140,141],{},"2,560 時間",[113,143,144,147],{},[128,145,146],{},"チャンネル登録者数",[128,148,149],{},"89 人",[37,151,152],{},"所感としては、投稿本数に対して再生数はかなり多かった印象で、時間もそれなりって感じでした。",[37,154,155],{},"チャンネル登録者数に関しては、前チャンネルの時に比べると伸び率は少ないですが、わりと増えたなという印象です。",[100,157,158],{"id":158},"ゲームについての振り返り",[37,160,161],{},"プロセカに始まりプロセカに終わる一年でしたね！",[37,163,164],{},"前半の方ではデスストの動画を上げていましたが、ちょっと停滞してしまいました…いずれ上げて行くのでお手柔らかにお願いします。",[37,166,167],{},"基本的に今年はプロセカの動画以外を上げてなかったので、新規性はあまり無かったかも知れません。",[100,169,170],{"id":170},"配信についての振り返り",[37,172,173,174,177],{},"今年は、「リリオの配信局」から「リリオ」のメインチャンネルに配信を移行した流れがありました。",[175,176],"br",{},"\n今後は基本的にメインチャンネルに統一しての活動を画策しています。",[37,179,180],{},"配信チャンネルの方では 256 回ほど配信していて、メインチャンネルでは 30 本ほどの配信をしたみたいです。",[37,182,183],{},"配信時間は……多分 400 時間以上はやったんじゃないですかね…",[37,185,186],{},"内容はスプラトゥーン 3 とプロセカが中心で、かなりの割合を占めていました。",[37,188,189],{},"一人向けゲームとしては、",[191,192,193,197,200,203,206],"ul",{},[194,195,196],"li",{},"Pokémon LEGENDS アルセウス",[194,198,199],{},"Aperture Desk Job",[194,201,202],{},"FINAL FANTASY 1",[194,204,205],{},"Xenoblade Definitive Edition",[194,207,208],{},"ベヨネッタ 3",[37,210,211],{},"をやってました。",[37,213,214],{},"全部一応クリアしてますね。以外とゲームしましたね…w",[100,216,217],{"id":217},"〆",[37,219,220,221,223],{},"というわけでわりとプロセカの頻度がかなり高い 1 年でした。",[175,222],{},"\n来年はプロセカの頻度を下げるというよりはプロセカ以外のゲームの頻度を上げたいですね。",[37,225,226,227,229],{},"というわけで今年も一年ありがとうございました。",[175,228],{},"\n来年もよろしくお願いします。",{"title":59,"searchDepth":231,"depth":231,"links":232},2,[233,234,235,236],{"id":102,"depth":231,"text":102},{"id":158,"depth":231,"text":158},{"id":170,"depth":231,"text":170},{"id":217,"depth":231,"text":217},"2022年の動画投稿・配信・ゲーム活動の振り返り。","md",null,{"date":48,"tags":241,"excerpt":242},[50,51],{"type":34,"value":243},[244,248],[37,245,246],{},[57,247],{"alt":59,"src":60},[37,249,63],{},true,{"title":18,"description":237},"xyjfhe7c_DvZLGNc0lD4cB-82iVIpZCDYCql1i3xAHc",[254,256],{"title":14,"path":15,"stem":16,"description":255,"children":-1},"Discord Overlayの仕様変更で壊れたCSSを修正した手順メモ。",{"title":22,"path":23,"stem":24,"description":257,"children":-1},"ブログ再開と今後の活動についての最初の投稿。",1787510487794]