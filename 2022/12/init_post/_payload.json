[{"data":1,"prerenderedAt":106},["ShallowReactive",2],{"navigation_docs":3,"article-tag-navigation":26,"-2022-12-init-post":69,"-2022-12-init-post-surround":103},[4],{"title":5,"path":6,"stem":5,"children":7,"page":25},"2022","\u002F2022",[8],{"title":9,"path":10,"stem":11,"children":12,"page":25},"12","\u002F2022\u002F12","2022\u002F12",[13,17,21],{"title":14,"path":15,"stem":16},"Discordの疑似Vtuberキットが壊れたので修正した","\u002F2022\u002F12\u002F02_discord_overlay","2022\u002F12\u002F02_discord_overlay",{"title":18,"path":19,"stem":20},"2022年の活動を振り返る","\u002F2022\u002F12\u002F03_lookback_2022","2022\u002F12\u002F03_lookback_2022",{"title":22,"path":23,"stem":24},"テスト投稿 どうもリリオです","\u002F2022\u002F12\u002Finit_post","2022\u002F12\u002F1.init_post",false,[27,46,64],{"title":14,"path":15,"meta":28},{"date":29,"tags":30,"excerpt":33},"2022-12-21 23:42:00",[31,32],"Discord","CSS",{"type":34,"value":35},"minimark",[36,40,43],[37,38,39],"p",{},"どうも、リリオです。",[37,41,42],{},"今まで使っていた Discord の Overlay を使用した OBS の Vtuber キットが HTML の仕様変更により使えなくなってしまいました。",[37,44,45],{},"今回はこちらの修正をしたのでコードを置いておこうと思います。",{"title":18,"path":19,"meta":47},{"date":48,"tags":49,"excerpt":52},"2022-12-29 18:25:30",[50,51],"振り返り","YouTube",{"type":34,"value":53},[54,61],[37,55,56],{},[57,58],"img",{"alt":59,"src":60},"","https:\u002F\u002Fuser-images.githubusercontent.com\u002F7778943\u002F209963456-0501e8eb-9d71-4aa9-bee9-6f5c30f0eeb3.jpg",[37,62,63],{},"どうも、リリオです。まだ Hexo の使い方に慣れていないので上手い書き方ができてないんですが、今年の活動をざっと振り返りたいと思います。",{"title":22,"path":23,"meta":65},{"date":66,"tags":67},"2022-12-21 01:29:00",[68],"雑記",{"id":70,"title":22,"body":71,"description":95,"extension":96,"links":97,"meta":98,"navigation":100,"path":23,"seo":101,"stem":24,"__hash__":102},"docs\u002F2022\u002F12\u002F1.init_post.md",{"type":34,"value":72,"toc":92},[73,76,83,89],[37,74,75],{},"どうもリリオです。",[37,77,78,79,82],{},"Hexo でブログを作りたい作りたい…と思いつつ多分半年くらい、Hexo を組み上げたり Astro を入れてみたりしてたんですが、",[80,81],"br",{},"\n色々やってるうちに完全に忘れていました。",[37,84,85,86,88],{},"正直はてなブログの方の更新も止まっているので、YouTube と Twitter と Discord のみで活動していこうかと考えていたのですが、",[80,87],{},"\nTwitter も最近おかしなことがおきつつあるので、少しずつミニブログなどもまとめていこうかと思います。",[37,90,91],{},"ちょっと眠すぎるのでここまで…",{"title":59,"searchDepth":93,"depth":93,"links":94},2,[],"ブログ再開と今後の活動についての最初の投稿。","md",null,{"date":66,"tags":99},[68],true,{"title":22,"description":95},"tdaQbM9sNrb7COK3XEHiv3X6qJhKVhgzEJf7aZfAPqI",[104,97],{"title":18,"path":19,"stem":20,"description":105,"children":-1},"2022年の動画投稿・配信・ゲーム活動の振り返り。",1787510487794]